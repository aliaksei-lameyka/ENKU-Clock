(kicad_pcb (version 20240108) (generator "pcbnew")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (34 "B.Paste" user "b.paste")
    (35 "F.Paste" user "f.paste")
    (36 "B.SilkS" user "b.silkscreen")
    (37 "F.SilkS" user "f.silkscreen")
    (38 "B.Mask" user "b.mask")
    (39 "F.Mask" user "f.mask")
    (44 "Edge.Cuts" user)
    (46 "B.CrtYd" user "b.courtyard")
    (47 "F.CrtYd" user "f.courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup (pad_to_mask_clearance 0) (allow_soldermask_bridges_in_footprints no))
  (net 0 "")
  (net 1 "GND")
  (net 2 "SNOOZE_SW")

  (gr_rect (start 0 0) (end 26 18)
    (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
  (gr_text "ENKU CLOCK SNOOZE REV A"
    (at 13 1.2) (layer "B.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)) (justify mirror)))

  (footprint "MountingHole:MountingHole_2.2mm_M2" (layer "F.Cu")
    (at 3 14.8)
    (attr board_only exclude_from_pos_files exclude_from_bom)
    (property "Reference" "H1" (at 0 -2) (layer "F.SilkS") hide)
    (pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask")))
  (footprint "MountingHole:MountingHole_2.2mm_M2" (layer "F.Cu")
    (at 23 14.8)
    (attr board_only exclude_from_pos_files exclude_from_bom)
    (property "Reference" "H2" (at 0 -2) (layer "F.SilkS") hide)
    (pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask")))

  (footprint "ENKU_Clock:KSC221GLFS" (layer "F.Cu")
    (at 13 6.2)
    (property "Reference" "SW1" (at 0 -4.6) (layer "F.SilkS") hide)
    (property "Value" "KSC221GLFS" (at 0 4.6) (layer "F.Fab") hide)
    (fp_rect (start -3.1 -3.1) (end 3.1 3.1) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
    (fp_circle (center 0 0) (end 1.5 0) (stroke (width 0.12) (type default)) (fill none) (layer "F.SilkS"))
    (pad "1" smd rect (at -4.45 -2) (size 3.1 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "1" smd rect (at -4.45 2) (size 3.1 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "2" smd rect (at 4.45 -2) (size 3.1 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "SNOOZE_SW"))
    (pad "2" smd rect (at 4.45 2) (size 3.1 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "SNOOZE_SW"))
  )

  (footprint "Connector_JST:JST_GH_SM03B-GHS-TB_1x03-1MP_P1.25mm_Horizontal" (layer "F.Cu")
    (at 13 14.6)
    (property "Reference" "J1" (at 0 -3.9) (layer "F.SilkS") hide)
    (property "Value" "SM03B-GHS-TB" (at 0 3.9) (layer "F.Fab") hide)
    (fp_rect (start -3.5 -1.6) (end 3.5 2.45) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
    (pad "1" smd roundrect (at -1.25 -1.85) (size 0.6 1.7) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25) (net 1 "GND"))
    (pad "2" smd roundrect (at 0 -1.85) (size 0.6 1.7) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25) (net 2 "SNOOZE_SW"))
    (pad "3" smd roundrect (at 1.25 -1.85) (size 0.6 1.7) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25) (net 1 "GND"))
    (pad "MP" smd roundrect (at -3.1 1.35) (size 1 2.7) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25))
    (pad "MP" smd roundrect (at 3.1 1.35) (size 1 2.7) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.25))
  )

  (segment (start 17.45 4.2) (end 18.6 4.2) (width 0.35) (layer "F.Cu") (net 2))
  (segment (start 18.6 4.2) (end 18.6 11.0) (width 0.35) (layer "F.Cu") (net 2))
  (segment (start 17.45 8.2) (end 18.6 8.2) (width 0.35) (layer "F.Cu") (net 2))
  (segment (start 18.6 11.0) (end 18.6 10.5) (width 0.35) (layer "F.Cu") (net 2))
  (segment (start 18.6 10.5) (end 13 10.5) (width 0.35) (layer "F.Cu") (net 2))
  (segment (start 13 10.5) (end 13 12.75) (width 0.35) (layer "F.Cu") (net 2))

  (segment (start 8.55 4.2) (end 7.4 4.2) (width 0.45) (layer "F.Cu") (net 1))
  (segment (start 7.4 4.2) (end 7.4 11.2) (width 0.45) (layer "F.Cu") (net 1))
  (segment (start 8.55 8.2) (end 7.4 8.2) (width 0.45) (layer "F.Cu") (net 1))
  (segment (start 7.4 11.2) (end 11.75 12.75) (width 0.45) (layer "F.Cu") (net 1))
  (segment (start 14.25 12.75) (end 19.8 12.75) (width 0.45) (layer "B.Cu") (net 1))
  (segment (start 19.8 12.75) (end 19.8 12.4) (width 0.45) (layer "B.Cu") (net 1))
  (segment (start 19.8 12.4) (end 7.4 12.4) (width 0.45) (layer "B.Cu") (net 1))
  (segment (start 7.4 12.4) (end 7.4 11.2) (width 0.45) (layer "B.Cu") (net 1))
  (via (at 14.25 12.75) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 1))
  (via (at 7.4 11.2) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 1))

  (gr_text "GND  SNOOZE"
    (at 13 17.0) (layer "B.SilkS")
    (effects (font (size 0.65 0.65) (thickness 0.10)) (justify mirror)))  (gr_text "SW1"
    (at 13 6.2) (layer "B.SilkS")
    (effects (font (size 0.55 0.55) (thickness 0.10)) (justify mirror)))
  (gr_text "J1"
    (at 13 15.9) (layer "B.SilkS")
    (effects (font (size 0.55 0.55) (thickness 0.10)) (justify mirror)))

)
